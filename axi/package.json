{
  "name": "ub-axi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint --deny-warnings packages",
    "fmt": "oxfmt packages/*/src",
    "fmt:check": "oxfmt --check packages/*/src",
    "test": "vitest run",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm -r --if-present run skill:check",
    "skills": "pnpm -r --if-present run skill"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
